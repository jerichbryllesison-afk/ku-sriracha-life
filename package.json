  "description": "KU Sriracha Life — online student life simulator on the real Kasetsart University Sriracha map (max 100 players).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
